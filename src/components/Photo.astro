---
import photos from '../content/photos.json';
interface Props { id: string; alt: string; eager?: boolean; class?: string; focal?: string; sizes?: string }
const {id, alt, eager = false, class: className = '', focal, sizes = '(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 600px'} = Astro.props;
import {site} from '../content/business';
const photo = photos[id as keyof typeof photos];
const illustrative = photo?.illustrative || site.reviewMode;
---
<figure class:list={['photo',className]}>
  <img src={photo?.src || `/images/${id}.webp`} srcset={photo?.srcset} sizes={sizes} alt={`${illustrative ? 'Imagen ilustrativa: ' : ''}${alt}`} width={photo?.width || 800} height={photo?.height || 1000} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} style={`object-position:${focal || photo?.focal || 'center'}`} />
  {illustrative && <figcaption>Imagen ilustrativa · IA</figcaption>}
</figure>
