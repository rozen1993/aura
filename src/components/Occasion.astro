---
import Intro from './Intro.astro';
import Photo from './Photo.astro';
import Process from './Process.astro';
import PackageCard from './PackageCard.astro';
import CTA from './CTA.astro';
import {packages} from '../content/business';
const {xv = false} = Astro.props;
const ids = xv ? ['xv-experience','sweet-xv-party'] : ['bridal','bridal-luxury','bride-tribe'];
const href = `/reservar?evento=${xv ? 'quinceanero' : 'matrimonio'}`;
---
<Intro label={xv ? 'Quinceañeras' : 'Novias'} title={xv ? 'Un look tan especial<br><em>como tus quince.</em>' : 'Para tu “sí, acepto”,<br><em>siendo tú.</em>'} description={xv ? 'Celebramos tu estilo con maquillaje y peinado que se sienten frescos, elegantes y tuyos.' : 'Diseñamos maquillaje y peinado en armonía con tus facciones, tu vestido y la historia que vas a vivir.'}/>
<section class="section split"><div class="portrait"><Photo id={xv ? 'xv' : 'hero'} alt={xv ? 'Look de quinceañera' : 'Look de novia'} eager/></div><div class="body-copy"><span class="eyebrow">{xv ? 'XV Experience' : 'Bridal Experience'}</span><h2>{xv ? <>Imagina tu momento.<br/>Diseñemos tu look.</> : <>Tu gran día empieza<br/>con tranquilidad.</>}</h2><p>{xv ? 'La prueba nos permite descubrir lo que te gusta, coordinar los accesorios y preparar un look con el que te sientas cómoda.' : 'En la prueba exploramos tus referencias, elegimos los detalles y coordinamos la preparación para llegar a tu día con un plan claro.'}</p><ul class="checks"><li>Consulta de estilo y referencias {xv && 'con tu persona responsable'}</li><li>Prueba de maquillaje y peinado</li><li>Diseño del look y coordinación de accesorios</li><li>Preparación el día de tu celebración</li><li>Kit de retoque según paquete</li></ul><a class="button" href={href}>Consultar mi fecha ↗</a></div></section>
<div class="band"><section class="section center"><span class="eyebrow">Paso a paso</span><h2>Una experiencia pensada para ti.</h2><Process trial/></section></div><section class="section"><div class="section-head"><h2>{xv ? 'Celebra a tu manera' : 'Elige tu experiencia Bridal'}</h2><a href="/paquetes">Ver todos →</a></div><div class="package-grid">{packages.filter(p => ids.includes(p.id)).map(p => <PackageCard p={p}/>)}</div></section><section class="section !pt-0"><div class="duo"><article class="contact-box"><h3>Comparte el momento.</h3><p>{xv ? 'Mamá y dos acompañantes pueden sumarse con Sweet XV Party.' : 'Suma a mamá, madrina o damas con Bride Tribe.'} El horario y los servicios de cada persona se coordinan en la propuesta.</p><a class="link" href={`/paquetes/${xv ? 'sweet-xv-party' : 'bride-tribe'}`}>Ver paquete grupal →</a></article><article class="contact-box"><h3>Los detalles de tu prueba.</h3><p>Lleva referencias, fotografías del vestido y tus accesorios. Cuéntanos tus preferencias y sensibilidades conocidas.</p><a class="link" href="/preguntas-frecuentes">Preparar mi cita →</a></article></div><p class="note">{xv ? 'La consulta y la confirmación para menores se coordinan con su persona responsable. El uso de fotografías requiere una autorización separada.' : 'La atención a domicilio requiere confirmar cobertura y traslado. Los bloques de retoque se acuerdan en la cotización.'}</p></section><CTA title={xv ? 'Tus quince, tu esencia.' : 'Hablemos de tu gran día.'} href={href}/>
