---
import services from '../content/services.json';
import Photo from './Photo.astro';
---
<div class="service-grid">{services.map(([id,name,description,image]) => <a class="service-card" href={['novias','quinceaneras'].includes(id) ? `/${id}` : `/servicios/${id}`}><Photo id={image} alt={name} sizes="(max-width: 760px) 50vw, (max-width: 1100px) 33vw, 240px"/><div><h3>{name}</h3><p>{description}</p><span class="link">Descubrir →</span></div></a>)}</div>
