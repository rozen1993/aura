---
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import Process from '../components/Process.astro';
import FAQ from '../components/FAQ.astro';
import {site} from '../content/business';
---
<Layout title="Contacto y consultas" description="Cuéntanos la fecha, el lugar y la ocasión de tu evento. Prepara tu consulta de disponibilidad y encuentra la experiencia adecuada."><Intro label="Contacto" title="Conversemos sobre<br><em>tu próximo momento.</em>" description="Cuéntanos la fecha y la ocasión. Te ayudamos a encontrar la experiencia adecuada para ti."/><section class="section"><div class="contact-grid"><article class="contact-box"><span class="eyebrow">Tu evento</span><h3>Consulta disponibilidad</h3><p>Comparte los detalles y prepara tu consulta en pocos pasos.</p><a class="button" href="/reservar">Preparar consulta ↗</a>{site.whatsapp && /^\d{8,15}$/.test(site.whatsapp) && <p><a class="link" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></p>}</article><article class="contact-box"><span class="eyebrow">Dónde nos encontramos</span><h3>Estudio y domicilio</h3><p>{site.address || 'La ubicación del estudio y la cobertura a domicilio están pendientes de confirmación.'}</p>{site.businessHours && <p>{site.businessHours}</p>}</article><article class="contact-box"><span class="eyebrow">Inspiración</span><h3>Nuestro universo</h3><p>Descubre estilos de maquillaje y peinado antes de elegir.</p><a class="link" href="/galeria">Explorar galería →</a>{site.instagram && <p><a class="link" href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a></p>}</article></div></section><div class="band"><section class="section center"><span class="eyebrow">Antes de hablar</span><h2>Ten a mano estos detalles.</h2><Process/></section></div><section class="section"><FAQ all={false}/></section></Layout>
