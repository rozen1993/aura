---
import '../styles/global.css';
import '../styles/refinements.css';
import {site} from '../content/business';
interface Props {title: string; description: string}
const {title,description} = Astro.props;
const links = [['/servicios','Servicios'],['/novias','Novias'],['/quinceaneras','Quinceañeras'],['/galeria','Galería'],['/paquetes','Paquetes'],['/nosotros','El estudio']];
const canonical = Astro.site ? new URL(Astro.url.pathname,Astro.site) : undefined;
---
<!doctype html><html lang={site.locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | {site.brand}</title><meta name="description" content={description}/>{site.reviewMode && <meta name="robots" content="noindex,nofollow"/>}{canonical && <link rel="canonical" href={canonical}/>}<meta name="theme-color" content="#FBF7F3"/><meta property="og:title" content={`${title} | ${site.brand}`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="icon" href="/favicon.svg"/></head><body>
<a class="skip" href="#main">Ir al contenido</a>{site.reviewMode && <div class="prototype">Versión de revisión · Marca provisional · Fotografías de referencia</div>}
<header class="relative"><a class="logo" href="/">{site.brand.replace(/ Studio$/,'')}<small>Studio · Beauty atelier</small></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menú ☰</button><nav id="navigation" aria-label="Principal">{links.map(([href,label]) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}<a class="button small" href="/reservar">Reserva ahora ↗</a></nav></header>
<main id="main" tabindex="-1"><slot/></main>
<footer><div class="footer-top"><a class="logo" href="/">{site.brand.replace(/ Studio$/,'')}<small>Tu belleza, nuestro arte.</small></a><p>Maquillaje y peinado para vivir<br/>tus momentos con confianza.</p><a class="button outline" href="/reservar">Diseñemos tu look ↗</a></div><div class="footer-links"><a href="/contacto">Contacto</a><a href="/preguntas-frecuentes">Preguntas frecuentes</a><a href="/privacidad">Privacidad</a><a href="/condiciones">Condiciones</a>{site.instagram && <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}<span>© {new Date().getFullYear()} {site.brand}</span></div></footer>
<div class="bottom-mobile"><a href="/reservar">Consultar disponibilidad ↗</a></div>
<script>
const menu = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
const nav = document.querySelector<HTMLElement>('#navigation')!;
const close = () => {nav.classList.remove('open');menu.setAttribute('aria-expanded','false');};
menu.addEventListener('click',() => {const open = nav.classList.toggle('open');menu.setAttribute('aria-expanded',String(open));});
nav.querySelectorAll('a').forEach(link => link.addEventListener('click',close));
document.addEventListener('keydown',event => {if(event.key === 'Escape' && nav.classList.contains('open')){close();menu.focus();}});
document.querySelectorAll<HTMLImageElement>('img').forEach(img => {img.addEventListener('error',() => {img.hidden = true;img.closest('figure')?.classList.add('image-failed');});img.addEventListener('load',() => {img.hidden=false;img.closest('figure')?.classList.remove('image-failed');});});
</script>
</body></html>
